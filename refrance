FROM python:3.12-slim

WORKDIR /srv

COPY requirements.txt .

RUN pip install -r requirements.txt --no-cache-dir

RUN useradd -r -s /sbin/nologin appuser

RUN mkdir /data
ENV DATA_DIR=/data
COPY . .

RUN chown -R appuser:appuser /srv
RUN chown -R appuser:appuser /data

USER appuser

EXPOSE 5000

CMD ["python","app.py"]

